# ==========================================
# Agentic RAG — Environment Configuration
# Copy this file to .env and fill in your API keys
#   cp .env.example .env
# ==========================================

# ---- Anthropic Claude API ----
# Official API: https://api.anthropic.com
# Proxy API example: https://api.gptsapi.net
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model selection
PLANNER_MODEL=claude-opus-4-20250514
WRITER_MODEL=claude-opus-4-20250514
REVIEWER_MODEL=claude-opus-4-20250514
RESEARCHER_MODEL=claude-haiku-4-20250514

# ---- OpenAI API (for ChromaDB embeddings) ----
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ---- Zhihu AI (optional, for Chinese embedding models) ----
ZHIPUAI_API_KEY=...
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- Tavily Web Search ----
TAVILY_API_KEY=tvly-...

# ---- ChromaDB Local Vector Store ----
CHROMA_PERSIST_DIR=./chroma_data

# ---- Safety Limits ----
MAX_RESEARCH_ITERATIONS=3
MAX_BUDGET_USD=2.00
