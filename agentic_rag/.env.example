# ==========================================
# Agentic RAG — 环境变量配置
# 复制此文件为 .env 并填入你的 API 密钥
#   cp .env.example .env
# ==========================================

# ---- Anthropic Claude API ----
# 官方 API: https://console.anthropic.com
# 代理地址示例: https://api.gptsapi.net
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 模型选型（按任务复杂度分层调度）
# 规划师 / 撰稿人 / 审核人 → Claude Opus 4.7（强推理）
PLANNER_MODEL=claude-opus-4-20250514
WRITER_MODEL=claude-opus-4-20250514
REVIEWER_MODEL=claude-opus-4-20250514
# 研究员 → Claude Haiku 4.5（成本为 Opus 的 1/10）
RESEARCHER_MODEL=claude-haiku-4-20250514

# API 调用参数
ANTHROPIC_TIMEOUT_SECONDS=90
ANTHROPIC_MAX_RETRIES=4

# ---- OpenAI API（ChromaDB 文本嵌入）----
# 官方 API: https://platform.openai.com
# 代理地址示例: https://api.gptsapi.net/v1
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536  # 可选，不设置则使用模型默认维度

# ---- 智谱 AI（可选，中文嵌入模型备选）----
ZHIPUAI_API_KEY=...
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- Tavily 网页搜索 ----
# 注册获取: https://tavily.com
TAVILY_API_KEY=tvly-...

# ---- ChromaDB 本地向量库 ----
CHROMA_PERSIST_DIR=./chroma_data

# ---- 安全限制 ----
MAX_SUB_QUESTIONS=7              # 单次查询最大子问题数
MAX_RESEARCH_ITERATIONS=3        # 单章节最大重新检索次数
MAX_REVIEW_ITERATIONS=3          # Reviewer 批判闭环最大迭代次数
MAX_BUDGET_USD=2.00              # 单次报告硬性费用上限

# ---- Token 控制 ----
MAX_TOKENS_PER_SECTION=6000      # 撰稿人单章节最大输出 token
RESEARCHER_MAX_TOKENS=2500       # 研究员单次最大输出 token
REVIEWER_MAX_TOKENS=1500         # 审核人单次最大输出 token
