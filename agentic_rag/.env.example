# ==========================================
# Agentic RAG — 环境配置
# 复制此文件为 .env 并填入你的 API 密钥
#   cp .env.example .env
# ==========================================

# ---- Anthropic Claude API ----
# 官方 API: https://api.anthropic.com
# 中转站 API 示例: https://api.gptsapi.net
ANTHROPIC_API_KEY=sk-iNgf545868dc771394a3e46721abe8ebe0e456d342bhUcbH
ANTHROPIC_BASE_URL=https://api.gptsapi.net

# 模型选型（按你中转站支持的模型填写）
# 规划师 / 撰稿人 / 审核人 → 强推理模型
PLANNER_MODEL=claude-opus-4-7
WRITER_MODEL=claude-opus-4-7
REVIEWER_MODEL=claude-opus-4-7
# 研究员 → 便宜快速的模型（Haiku 成本约为 Opus 的 1/10）
RESEARCHER_MODEL=claude-haiku-4-5-20251001

# ---- OpenAI API（ChromaDB 向量嵌入用）----
# 官方 API: https://api.openai.com/v1
# 中转站 API 示例: https://api.gptsapi.net/v1
OPENAI_API_KEY=sk-iNgf545868dc771394a3e46721abe8ebe0e456d342bhUcbH
OPENAI_BASE_URL=https://api.gptsapi.net/v1
EMBEDDING_MODEL=text-embedding-3-small

# ---- Tavily 网页搜索 ----
TAVILY_API_KEY=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

# ---- ChromaDB 本地向量库 ----
CHROMA_PERSIST_DIR=./chroma_data

# ---- 安全限制 ----
MAX_RESEARCH_ITERATIONS=3
MAX_BUDGET_USD=2.00
